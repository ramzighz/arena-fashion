# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Security (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Admin credentials (used to seed the admin account on first run)
ADMIN_EMAIL=admin@yourbusiness.com
ADMIN_PASSWORD=changeme_use_strong_password

# Seller panel access key (set a strong secret for production)
SELLER_KEY=changeme_use_strong_secret

# OmniRoute AI Provider Endpoint & Key
OMNIROUTE_BASE_URL=http://localhost:8000/v1
OMNIROUTE_API_KEY=omniroute_sec_key_placeholder

# Spend Cap & Rate Limits
OMNIROUTE_SPEND_CAP_USD=50.00
OMNIROUTE_MAX_REQUESTS_PER_MIN=20

# Product image hosting (cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# New-order notifications (fill either pair)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
